[Unit]
Description=Choose home Wi-Fi or the ImprovDSP hotspot at startup
Wants=NetworkManager.service
After=NetworkManager.service
Before=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/improvdsp-select-network
RemainAfterExit=yes
TimeoutStartSec=75
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
